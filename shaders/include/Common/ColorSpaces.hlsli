#ifndef CER_COLOR_SPACES_HLSLI
#define CER_COLOR_SPACES_HLSLI

static const float3x3 AP1_2_XYZ_MAT = {
	0.6624541811,
	0.1340042065,
	0.1561876870,
	0.2722287168,
	0.6740817658,
	0.0536895174,
	-0.0055746495,
	0.0040607335,
	1.0103391003,
};

static const float3x3 XYZ_2_AP1_MAT = {
	1.6410233797,
	-0.3248032942,
	-0.2364246952,
	-0.6636628587,
	1.6153315917,
	0.0167563477,
	0.0117218943,
	-0.0082844420,
	0.9883948585,
};

static const float3x3 XYZ_2_sRGB_MAT = {
	3.2409699419,
	-1.5373831776,
	-0.4986107603,
	-0.9692436363,
	1.8759675015,
	0.0415550574,
	0.0556300797,
	-0.2039769589,
	1.0569715142,
};

static const float3x3 sRGB_2_XYZ_MAT = {
	0.4123907993,
	0.3575843394,
	0.1804807884,
	0.2126390059,
	0.7151686788,
	0.0721923154,
	0.0193308187,
	0.1191947798,
	0.9505321522,
};

static const float3x3 D65_2_D60_CAT = {
	1.0130349146,
	0.0061052578,
	-0.0149709436,
	0.0076982301,
	0.9981633521,
	-0.0050320385,
	-0.0028413174,
	0.0046851567,
	0.9245061375,
};

static const float3x3 D60_2_D65_CAT = {
	0.9872240087,
	-0.0061132286,
	0.0159532883,
	-0.0075983718,
	1.0018614847,
	0.0053300358,
	0.0030725771,
	-0.0050959615,
	1.0816806031,
};

float3 sRGBToAP1(float3 sRGB)
{
	float3 XYZ = mul(sRGB_2_XYZ_MAT, sRGB);
	XYZ = mul(D65_2_D60_CAT, XYZ);
	return mul(XYZ_2_AP1_MAT, XYZ);
}

float3 AP1TosRGB(float3 AP1)
{
	float3 XYZ = mul(AP1_2_XYZ_MAT, AP1);
	XYZ = mul(D60_2_D65_CAT, XYZ);
	return mul(XYZ_2_sRGB_MAT, XYZ);
}

#endif
