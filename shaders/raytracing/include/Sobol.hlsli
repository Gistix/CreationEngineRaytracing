#ifndef SOBOL_HLSLI
#define SOBOL_HLSLI

// Scrambled Sobol low-discrepancy sampler with PCG PRNG fallback.
//
// Packs sampler state into `uint randomSeed`:
//   High 16 bits = spatial scramble key (unique per pixel)
//   Middle 8 bits = sample index (0..255 per frame/iteration)
//   Low    8 bits = dimension counter (0..255 per path)
//
// Reference: Burley, "Practical Hash-based Owen Scrambling" (2019).
// Direction numbers from Joe & Kuo (2008).

#define SOBOL_DIM_TABLE_SIZE 32

uint PCGHash(uint seed)
{
    uint state = seed * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

