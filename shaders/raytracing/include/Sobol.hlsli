        0x80000000u, 0xC0000000u, 0xE0000000u, 0xD0000000u,
        0x08000000u, 0x54000000u, 0xDC000000u, 0x36000000u,
        0x16000000u, 0xA1000000u, 0xA1A00000u, 0xF8700000u,
        0x70500000u, 0x30080000u, 0x10820000u, 0xB0C30000u,
        0x08E38000u, 0x54514000u, 0xDC596000u, 0x36041000u,
        0x168E3000u, 0xA1C51800u, 0xA1459800u, 0xF8204400u,
        0x7000E680u, 0x300051C0u, 0x10005140u, 0xB0000820u,
        0x08008008u, 0x5400C00Cu, 0xDC00E00Eu, 0x36005005u,
    },
    { // dim 32
        0x80000000u, 0x40000000u, 0x60000000u, 0xF0000000u,
        0x28000000u, 0x7C000000u, 0xDA000000u, 0x01000000u,
        0x02800000u, 0x61C00000u, 0xB9600000u, 0xE0900000u,
        0xC4380000u, 0x0A340000u, 0x278A0000u, 0xF2010000u,
        0x20638000u, 0x48B3C000u, 0xDC61A000u, 0x0A0C7000u,
        0x049C4800u, 0x61490400u, 0xB0808200u, 0xE4204300u,
        0x40606580u, 0x8008B340u, 0xA09C6860u, 0x704A08D0u,
        0x28449808u, 0x4CA14314u, 0xDA70878Eu, 0x0124220Bu,
    }
};

// Return a single Sobol point in [0,1) for dimension `dim` at sample index
// `idx`, scrambled using `scrambleKey`.
float SobolSample(uint idx, uint dim, uint scrambleKey)
{
    uint bits;

    if (dim >= SOBOL_DIM_TABLE_SIZE)
    {
        // High dimensions fallback to PCG pseudo-random sequence to prevent correlation
        bits = PCGHash(scrambleKey ^ (dim * 0x9E3779B1u) ^ (idx * 0x85EBCA6Bu));
    }
    else if (dim == 0u)
    {
        // Dimension 0: van der Corput via bit reversal.
        bits = reversebits(idx);
    }
    else
    {
        // Higher dimensions (dim 1..31): XOR-fold direction numbers for set bits of `idx`.
        bits = 0u;
        uint i = idx;
        uint bitPos = 0u;
        [loop]
        while (i != 0u && bitPos < 32u)
        {
            if (i & 1u)
                bits ^= kSobolV[dim - 1u][bitPos];
            i >>= 1u;
            bitPos++;
        }
    }

    // Fast Cranley-Patterson / Kollig-Keller XOR scramble for decorrelation
    uint scrambleMask = PCGHash(scrambleKey ^ (dim * 0x9E3779B1u));
    bits ^= scrambleMask;

    // Map upper 24 bits to float in [0, 1)
    return float(bits >> 8) * (1.0f / 16777216.0f);
}

// Pack/unpack helpers for the uint randomSeed slot.
// High 16 bits = spatial scramble key (unique per pixel)
// Middle 8 bits = sample index (0..255 per frame/iteration)
// Low    8 bits = dimension counter (0..255 per path)
static const uint SOBOL_KEY_SHIFT    = 16u;
static const uint SOBOL_SAMPLE_SHIFT = 8u;
static const uint SOBOL_DIM_MASK     = 0xFFu;

uint SobolPackSeed(uint key, uint sampleIdx, uint dim)
{
    return ((key & 0xFFFFu) << SOBOL_KEY_SHIFT) | ((sampleIdx & 0xFFu) << SOBOL_SAMPLE_SHIFT) | (dim & SOBOL_DIM_MASK);
}

uint SobolUnpackKey(uint seed)
{
    return seed >> SOBOL_KEY_SHIFT;
}

uint SobolUnpackSample(uint seed)
{
    return (seed >> SOBOL_SAMPLE_SHIFT) & 0xFFu;
}

uint SobolUnpackDim(uint seed)
{
    return seed & SOBOL_DIM_MASK;
}

#endif // SOBOL_HLSLI
